<head><meta charset='utf-8'><title>H.E.L.P. Center — Self-Serve SaaS Plan</title>
<style>
body{font-family:'Calibri','Inter',Arial,sans-serif;max-width:820px;margin:24px auto;padding:0 28px;color:#0F172A;line-height:1.6;font-size:13.5pt}
h1{font-size:23pt;color:#0F172A;border-bottom:3px solid #7C3AED;padding-bottom:8px;margin:0 0 6px}
h2{font-size:16pt;color:#1E5BC0;margin:26px 0 8px;border-bottom:1px solid #E2E8F0;padding-bottom:4px}
h3{font-size:13.5pt;color:#0F172A;margin:18px 0 6px}
p{margin:8px 0}
ul,ol{margin:8px 0;padding-left:24px}
li{margin:5px 0}
ul ul,ol ul{margin:2px 0}
em{color:#475569}
code{font-family:Consolas,'Courier New',monospace;background:#F1F5F9;padding:1px 6px;border-radius:3px;font-size:11pt}
table{border-collapse:collapse;width:100%;margin:12px 0}
th,td{border:1px solid #CBD5E1;padding:7px 10px;text-align:left;font-size:11.5pt;vertical-align:top}
th{background:#EEF2FF;font-weight:700;color:#3730A3}
hr{border:0;border-top:1px solid #CBD5E1;margin:22px 0}
.sub{color:#64748B;font-style:italic;font-size:11.5pt;margin-top:2px}
